API_PORT=3000
API_ENDPOINT=http://localhost:3000
API_SYNC_RETRY_ATTEMPTS=3
API_SYNC_RETRY_DELAY_MS=150
API_SYNC_TIMEOUT_MS=5000
GAME_PORT=2567
BOT_COUNT=0
# 匹配队列等待超时（毫秒），队首超时后按现有人数补 bot 开局
# 机器人出牌延迟：默认不设置，按相位模拟真人思考（领出久、跟牌/过牌快、叫抢短停顿，带随机抖动）。
# 仅在需要固定延迟时设置（如冒烟测试压成极小值），设置后将关闭拟真节奏。
# BOT_MOVE_DELAY_MS=50
# 回合超时(毫秒):到点自动兜底动作仅对真人玩家生效(挂机自动按规则出牌)。
# 牌桌上真人与机器人都显示同一个倒计时闹钟(表现一致);规则机器人沿用此时长(靠思考延迟在归零前出牌)。
TURN_TIMEOUT_MS=20000
# 大模型机器人回合的展示倒计时(毫秒):比真人长,留推理时间。纯视觉——到点不自动出牌,
# 可停在 0 继续等模型返回;其真超时由下方 BOT_DECISION_TIMEOUT_MS 收口。
# BOT_LLM_TURN_TIMER_MS=30000
# 并发 joinOrCreate 等待建房完成的上限（秒）。崩溃恢复建房含 API 往返，
# 默认 0.5s 过短会让第二个客户端逃逸重建；DdzRoom 注册表已兜底，调大可少一次报错重试
COLYSEUS_MAX_CONCURRENT_CREATE_ROOM_WAIT_TIME=5
DATABASE_URL=postgresql://postgres:123456@localhost:5433/ddz
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=ddz-api
JWT_AUDIENCE=ddz-web
ACCESS_TOKEN_TTL_SECONDS=3600
INTERNAL_API_TOKEN=replace-with-a-long-random-internal-token
DEMO_USER_ENABLED=true
DEMO_USER_USERNAME=alice
DEMO_USER_NICKNAME=Alice
DEMO_USER_PASSWORD=secret123
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_ENDPOINT=http://localhost:3000
VITE_GAME_ENDPOINT=http://localhost:2567
# 大模型机器人(默认全部关闭/规则;选 LLM 但缺 key 时建房直接报错,不静默降级)
# 多 provider / 多模型配置走 JSON 文件:复制 bot-providers.example.json 为 bot-providers.json(已 gitignore),
# 在其中填各家 provider 的 api_key / base_url / models(含密钥,仅服务端持有,绝不下发前端)。
# 不配置该文件时,回退用下面的 ANTHROPIC_API_KEY 合成单一 anthropic 供应商(向后兼容)。
# ANTHROPIC_API_KEY=sk-ant-...
# bot-providers.json 的自定义路径(相对仓库根或绝对路径),默认仓库根 bot-providers.json
# BOT_PROVIDERS_FILE=bot-providers.json
# 或直接把整份配置内联成 JSON 注入(优先级高于文件),部署友好:docker-compose/PaaS/serverless 免挂卷
# BOT_PROVIDERS={"provider":"deepseek","model":"deepseek-v4-pro","providers":{...}}
# 人格解说:true 时机器人出牌后异步生成一句台词(纯装饰,不参与决策;用注册表默认模型)
# BOT_CHAT_ENABLED=false
# 出牌决策来源:rule(规则,默认)| llm(大模型,仅出牌相位,失败抛错暴露不回退)
# BOT_DECISION=rule
# 大模型对局创建开关:竞技场(3 席全 AI)/挑战桌(1 真人 + 2 AI 对手)/LLM 决策房共用此闸门;
# 即使配置了 provider key,也需要显式开启才允许创建,用于控制真实模型费用。
# AI_BATTLE_ENABLED=false
# 同一 game-server 进程内同时活跃的大模型房间(竞技场+挑战桌)上限,默认 1。
# AI_BATTLE_MAX_ACTIVE=1
# LLM 单步出牌决策超时(毫秒),默认 60000。前沿/推理模型(gpt-5.5、o 系、deepseek thinking)思考慢,需给足;
# 这是 bot 出牌唯一的决策时钟(bot 回合不受上面 TURN_TIMEOUT_MS 管辖),到点 abort 抛错暴露,不回退规则。
# BOT_DECISION_TIMEOUT_MS=60000
# LLM 决策逐手留证:true 时把每手出牌的完整信息(游戏上下文+手牌+system/prompt+模型思考 reasoning+原始输出+
# 用量+延迟+结局,成功/no_choice/越界/abort 每种都记)写成 JSONL,供排错与优化。默认关,仅服务端落盘、不含密钥。
# BOT_DECISION_TRACE=false
# 留证目录(相对仓库根或绝对路径),默认 logs/llm-traces;文件名 <房间码>-<起始时间>.jsonl
# BOT_TRACE_DIR=logs/llm-traces
