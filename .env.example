API_PORT=3000
API_ENDPOINT=http://localhost:3000
API_SYNC_RETRY_ATTEMPTS=3
API_SYNC_RETRY_DELAY_MS=150
API_SYNC_TIMEOUT_MS=5000
GAME_PORT=2567
BOT_COUNT=0
# 匹配队列等待超时（毫秒），队首超时后按现有人数补 bot 开局
MATCH_TIMEOUT_MS=8000
BOT_MOVE_DELAY_MS=500
TURN_TIMEOUT_MS=20000
# 并发 joinOrCreate 等待建房完成的上限（秒）。崩溃恢复建房含 API 往返，
# 默认 0.5s 过短会让第二个客户端逃逸重建；DdzRoom 注册表已兜底，调大可少一次报错重试
COLYSEUS_MAX_CONCURRENT_CREATE_ROOM_WAIT_TIME=5
DATABASE_URL=postgresql://postgres:123456@localhost:5433/ddz
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=ddz-api
JWT_AUDIENCE=ddz-web
ACCESS_TOKEN_TTL_SECONDS=3600
INTERNAL_API_TOKEN=replace-with-a-long-random-internal-token
DEMO_USER_ENABLED=true
DEMO_USER_USERNAME=alice
DEMO_USER_NICKNAME=Alice
DEMO_USER_PASSWORD=secret123
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_ENDPOINT=http://localhost:3000
VITE_GAME_ENDPOINT=http://localhost:2567
