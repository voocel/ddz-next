# Copy to .env.production and replace every secret before exposing the server.

POSTGRES_DB=ddz
POSTGRES_USER=ddz
POSTGRES_PASSWORD=replace-with-a-strong-database-password

JWT_SECRET=replace-with-a-random-jwt-secret-at-least-32-characters
INTERNAL_API_TOKEN=replace-with-a-random-internal-token-at-least-32-characters
JWT_ISSUER=ddz-api
JWT_AUDIENCE=ddz-web
ACCESS_TOKEN_TTL_SECONDS=3600

# Browser-facing URLs. Defaults assume a reverse proxy on the same host.
# For direct public access without Caddy/Nginx, set PUBLIC_* to your server IP and change *_BIND to 0.0.0.0.
WEB_PORT=8080
API_PORT=3000
GAME_PORT=2567
WEB_BIND=127.0.0.1
API_BIND=127.0.0.1
GAME_BIND=127.0.0.1
PUBLIC_WEB_ORIGIN=http://localhost:8080
PUBLIC_API_ENDPOINT=http://localhost:3000
PUBLIC_GAME_ENDPOINT=http://localhost:2567
CORS_ORIGINS=http://localhost:8080

# Optional automatic HTTPS reverse proxy. Set DNS A/AAAA records before enabling the "https" profile.
# ACME_EMAIL=admin@example.com
# CADDY_WEB_HOST=ddz.example.com
# CADDY_API_HOST=api.ddz.example.com
# CADDY_GAME_HOST=game.ddz.example.com
# PUBLIC_WEB_ORIGIN=https://ddz.example.com
# PUBLIC_API_ENDPOINT=https://api.ddz.example.com
# PUBLIC_GAME_ENDPOINT=https://game.ddz.example.com
# CORS_ORIGINS=https://ddz.example.com

DEMO_USER_ENABLED=false
DEMO_USER_USERNAME=alice
DEMO_USER_NICKNAME=Alice
DEMO_USER_PASSWORD=

BOT_COUNT=0
TURN_TIMEOUT_MS=20000
BOT_LLM_TURN_TIMER_MS=30000

# LLM decision is opt-in. Keep rule for normal deployment without provider keys.
BOT_DECISION=rule
BOT_REASONING_EFFORT=off
BOT_DECISION_TIMEOUT_MS=60000
BOT_DECISION_TRACE=false
BOT_TRACE_DIR=logs/llm-traces

BOT_CHAT_ENABLED=false
BOT_CHAT_PERSONA=爱炫耀、嘴上不饶人但心态好的老牌玩家
BOT_CHAT_TIMEOUT_MS=4000
BOT_CHAT_MAX_CHARS=40

# LLM 对局创建闸门(竞技场/挑战桌共用)。provider key 与预算就绪前保持关闭。
AI_BATTLE_ENABLED=false
AI_BATTLE_MAX_ACTIVE=1

# Prefer BOT_PROVIDERS for container deployment so no secret file is copied into the image.
# BOT_PROVIDERS={"provider":"deepseek","model":"deepseek-v4-pro","providers":{"deepseek":{"type":"openai-compatible","base_url":"https://api.deepseek.com","api_key":"sk-...","models":["deepseek-v4-pro"]}}}
# ANTHROPIC_API_KEY=sk-ant-...
