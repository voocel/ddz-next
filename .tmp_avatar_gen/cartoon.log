--- /dev/null
+++ b/.tmp_avatar_gen/solid_bg.py
@@ -0,0 +1,62 @@
+from collections import deque
+from pathlib import Path
+import sys
+
+from PIL import Image
+
+
+def parse_hex(value: str) -> tuple[int, int, int]:
+    value = value.strip().lstrip("#")
+    if len(value) != 6:
+        raise ValueError(f"invalid hex color: {value!r}")
+    return tuple(int(value[i : i + 2], 16) for i in (0, 2, 4))
+
+
+def main() -> None:
+    if len(sys.argv) != 4:
+        raise SystemExit("usage: solid_bg.py <src> <dst> <hex-color>")
+
+    src = Path(sys.argv[1])
+    dst = Path(sys.argv[2])
+    target = parse_hex(sys.argv[3])
+    im = Image.open(src).convert("RGBA")
+    width, height = im.size
+    px = im.load()
+
+    threshold = 95
+    visited: set[tuple[int, int]] = set()
+    q: deque[tuple[int, int]] = deque()
+    for x in range(width):
+        q.append((x, 0))
+        q.append((x, height - 1))
+    for y in range(height):
+        q.append((0, y))
+        q.append((width - 1, y))
+
+    def is_bg(pixel: tuple[int, int, int, int]) -> bool:
+        r, g, b, a = pixel
+        if a < 10:
+            return True
+        dist = ((r - target[0]) ** 2 + (g - target[1]) ** 2 + (b - target[2]) ** 2) ** 0.5
+        return dist <= threshold
+
+    while q:
+        x, y = q.popleft()
+        if x < 0 or y < 0 or x >= width or y >= height or (x, y) in visited:
+            continue
+        if not is_bg(px[x, y]):
+            continue
+        visited.add((x, y))
+        px[x, y] = (*target, 255)
+        q.append((x + 1, y))
+        q.append((x - 1, y))
+        q.append((x, y + 1))
+        q.append((x, y - 1))
+
+    dst.parent.mkdir(parents=True, exist_ok=True)
+    im.save(dst)
+    print(f"{dst.resolve()} {width}x{height}")
+
+
+if __name__ == "__main__":
+    main()

