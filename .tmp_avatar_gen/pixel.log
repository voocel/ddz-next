}

def hex_rgb(s):
    s = s.lstrip('#')
    return tuple(int(s[i:i+2], 16) for i in (0, 2, 4))

def dist2(a, b):
    return sum((a[j] - b[j]) * (a[j] - b[j]) for j in range(3))

def median_color(samples):
    return tuple(sorted(p[j] for p in samples)[len(samples)//2] for j in range(3))

def bg_mask_for(pixels, w, h, target, target_thr=130, border_thr=95):
    border = []
    border.extend(pixels[0:w])
    border.extend(pixels[(h-1)*w:h*w])
    border.extend(pixels[y*w] for y in range(h))
    border.extend(pixels[y*w + (w-1)] for y in range(h))
    med = median_color(border)
    t2 = target_thr * target_thr
    b2 = border_thr * border_thr
    candidate = [(dist2(px, target) <= t2) or (dist2(px, med) <= b2) for px in pixels]
    seen = [False] * (w*h)
    q = deque()

    def add(idx):
        if candidate[idx] and not seen[idx]:
            seen[idx] = True
            q.append(idx)

    for x in range(w):
        add(x)
        add((h-1)*w + x)
    for y in range(h):
        add(y*w)
        add(y*w + (w-1))

    while q:
        idx = q.popleft()
        y, x = divmod(idx, w)
        if y > 0: add(idx - w)
        if y < h - 1: add(idx + w)
        if x > 0: add(idx - 1)
        if x < w - 1: add(idx + 1)
    return seen

for i in range(1, 13):
    path = out_dir / f'{i}.png'
    backup = orig_dir / f'{i}.png'
    if not backup.exists():
        shutil.copy2(path, backup)

