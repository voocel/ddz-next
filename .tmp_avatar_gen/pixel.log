    candidate = [(dist2(px, target) <= t2) or (dist2(px, med) <= b2) for px in pixels]
    seen = [False] * (w*h)
    q = deque()
    def add(idx):
        if candidate[idx] and not seen[idx]:
            seen[idx] = True; q.append(idx)
    for x in range(w):
        add(x); add((h-1)*w + x)
    for y in range(h):
        add(y*w); add(y*w + (w-1))
    while q:
        idx = q.popleft()
        y, x = divmod(idx, w)
        if y > 0: add(idx - w)
        if y < h - 1: add(idx + w)
        if x > 0: add(idx - 1)
        if x < w - 1: add(idx + 1)
    return seen

for i, color in colors.items():
    path = out_dir / f'{i}.png'
    bg = hex_rgb(color)
    img = Image.open(path).convert('RGB')
    base = img.resize((256, 256), Image.Resampling.NEAREST)
    pixels = list(base.getdata())
    w, h = base.size
    mask = bg_mask_for(pixels, w, h, bg)
    coverage = sum(mask) / len(mask)
    if coverage < 0.25:
        mask = bg_mask_for(pixels, w, h, bg, target_thr=175, border_thr=135)
        coverage = sum(mask) / len(mask)
    if coverage > 0.90:
        mask = bg_mask_for(pixels, w, h, bg, target_thr=95, border_thr=70)
        coverage = sum(mask) / len(mask)
    quant = base.quantize(colors=64, method=Image.Quantize.MEDIANCUT, dither=Image.Dither.NONE).convert('RGB')
    qpixels = list(quant.getdata())
    qpixels = [bg if mask[idx] else qpixels[idx] for idx in range(len(qpixels))]
    quant.putdata(qpixels)
    final = quant.resize((1024, 1024), Image.Resampling.NEAREST)
    final.save(path, format='PNG', optimize=True)
    print(f'{path} 1024x1024 bg={color} bg_coverage={coverage:.2%}')
