generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  nickname     String
  passwordHash String
  coin         Int           @default(1000)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  coinLedgers  CoinLedger[]
}

model Room {
  id        String   @id @default(cuid())
  code      String   @unique
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rounds    Round[]
  events    RoomEvent[]
  mutations GameActionMutation[]
  liveState RoomLiveState?
  claim     RoomClaim?
}

// 进行中牌局的完整状态（含手牌），仅供 game-server 崩溃恢复；
// 与 game actions 同事务 upsert，房间关闭时删除——状态行存在 ⇔ 崩溃可恢复
model RoomLiveState {
  roomId    String   @id
  room      Room     @relation(fields: [roomId], references: [id])
  state     Json
  updatedAt DateTime @updatedAt
}

model RoomEvent {
  id         String   @id @default(cuid())
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id])
  seq        Int
  playerId   String?
  playerKind String?
  type       String
  payload    Json
  createdAt  DateTime @default(now())

  @@unique([roomId, seq])
  @@index([roomId, createdAt])
  @@index([roomId, seq])
}

// 注意：Round 上还有一个 Prisma 无法表达的部分唯一索引
// "Round_roomId_open_round_key"（roomId WHERE endedAt IS NULL），
// 保证同一房间同时只有一局未结束，见迁移 add_settlement_constraints
model Round {
  id         String        @id @default(cuid())
  roomId     String
  room       Room          @relation(fields: [roomId], references: [id])
  landlordId String?
  startedAt  DateTime      @default(now())
  endedAt    DateTime?
  players    RoundPlayer[]
  actions    GameAction[]
  coinLedgers CoinLedger[]
}

model RoundPlayer {
  id         String @id @default(cuid())
  roundId    String
  round      Round  @relation(fields: [roundId], references: [id])
  playerId   String
  playerKind String
  seat       Int
  score      Int    @default(0)
  coinDelta  Int    @default(0)

  @@unique([roundId, seat])
  @@unique([roundId, playerId])
}

model GameAction {
  id        String   @id @default(cuid())
  roundId   String
  round     Round    @relation(fields: [roundId], references: [id])
  seq       Int
  playerId  String?
  playerKind String?
  type      String
  payload   Json
  createdAt DateTime @default(now())

  @@unique([roundId, seq])
  @@index([roundId, createdAt])
  @@index([roundId, seq])
}

model GameActionMutation {
  id                String   @id @default(cuid())
  roomId            String
  room              Room     @relation(fields: [roomId], references: [id])
  mutationId        String
  actionFingerprint String
  roomEventIds      String[] @default([])
  actionIds         String[] @default([])
  roundId           String?
  createdAt         DateTime @default(now())

  @@unique([roomId, mutationId])
  @@index([roomId, createdAt])
}

model CoinLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  roundId   String
  round     Round    @relation(fields: [roundId], references: [id])
  delta     Int
  balance   Int
  reason    String
  createdAt DateTime @default(now())

  // 同一局对同一用户只允许一条流水，防止重复结算入账
  @@unique([roundId, userId])
  @@index([userId, createdAt])
}

// game-server 对房间实例的显式租约。用于多进程部署时避免同一 roomCode 被多个实例同时恢复/运行。
model RoomClaim {
  roomId    String   @id
  room      Room     @relation(fields: [roomId], references: [id])
  ownerId   String
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([expiresAt])
}
