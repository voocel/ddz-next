  "dependencies": {
    "@colyseus/sdk": "^0.17.42",
    "@ddz/domain": "workspace:*",
    "@ddz/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "vitest": "^4.0.14"
  }
}
