{
  "name": "@ddz/smoke",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "preflight": "tsx src/preflight.ts",
